{
  "name": "rook-agent",
  "version": "0.1.1",
  "rookCapabilities": {
    "plythIntegration": 1
  },
  "description": "A coding agent that grows with your codebase.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "rook": "bin/rook.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "README.md",
    "models.example.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "prepack": "npm run build",
    "dev": "tsx src/cli.ts",
    "build": "node scripts/clean-dist.mjs && node scripts/patch-pi-oauth-page.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:pty": "vitest run tests/pty",
    "benchmark:memory": "tsx scripts/memory-benchmark.ts",
    "benchmark:fts": "tsx scripts/fts-benchmark.ts",
    "eval:coding": "tsx scripts/coding-eval.ts",
    "smoke": "node bin/rook.mjs --smoke"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "better-sqlite3": "^12.11.1",
    "highlight.js": "11.11.1",
    "typebox": "1.3.27",
    "typescript-legacy": "npm:typescript@5.9.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.0",
    "prettier": "3.6.2",
    "plyth-core": "file:../plyth",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "plyth-core": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "plyth-core": {
      "optional": true
    }
  }
}
