{
  "name": "rook",
  "version": "0.1.0",
  "description": "A coding agent that grows with your codebase.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "rook": "./bin/rook.mjs"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:pty": "vitest run tests/pty",
    "smoke": "node bin/rook.mjs --smoke"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-tui": "1.5.2",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.19.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
